# PostgreSQL (local instance — do not commit real credentials)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=customer_support_agent

# Optional: when set, this overrides the POSTGRES_* variables above
# DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/customer_support_agent

# OpenRouter (required — used for both chat completions and embeddings)
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional overrides (defaults shown — uncomment to change model/provider per environment)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_MAX_TOKENS=1024

# LangSmith tracing (optional — omit or set LANGSMITH_TRACING=false to disable)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LANGSMITH_PROJECT=your_langsmith_project
